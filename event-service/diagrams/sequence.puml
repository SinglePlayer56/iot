@startuml
actor User
participant "EventControllerV1" as EC
participant "EventService" as ES
participant "EventRepository" as ER
participant "MetricsService" as MS
participant "Cassandra" as DB

== GET /api/v1/events/?device_id=...&from_timestamp=...&to_timestamp=...&type=...&page=...&size=... ==

User -> EC: GET /api/v1/events?device_id=...\n&from_timestamp=...&to_timestamp=...&type=...&page=...&size=...

alt Не переданы обязательные параметры
    EC --> User: HTTP 400 BadRequest
else Обязательные параметры переданы
    EC -> ES: getEventsByFilters(params...)
    ES -> ER: getEventsByFilters(params...)
    ER -> DB: SELECT
    DB --> ER: List<Event>
    ER --> ES: List<Event>
    ES --> EC: EventPage
    EC --> User: HTTP 200 OK + EventPage
end

== GET /api/v1/events/{event_id}?device_id=... ==

User -> EC: GET /api/v1/events/{event_id}?device_id=...

alt Не переданы обязательные параметры
    EC --> User: HTTP 400 BadRequest
else Обязательные параметры переданы
    EC -> ES: getEventByIdAndDeviceId(event_id, device_id)
    ES -> ER: getEventByIdAndDeviceId(event_id, device_id)
    ER -> DB: SELECT
    DB --> ER: Optional<Event>
    ER --> ES: Optional<Event>

    alt Optional.empty()
        ES --> EC: NotFoundException
        EC --> User: HTTP 404 Not Found
    else
        ES --> EC: Event
        EC --> User: HTTP 200 OK + Event
    end
end

@enduml