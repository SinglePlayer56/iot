@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container_Boundary(event_collector_service, "Event Collector Service") {
    Component(event_service, "Event Collector Service", "Обработка событий")
    Component(event_repo, "Event Collector Repository", "DataStax Java Driver", "Запись событий в Cassandra")
    Component(dedup_cache, "Deduplicate Cache", "Проверка был ли уже опубликован device")
    Component(kafka_event_consumer, "Kafka Event Consumer", "Spring Kafka", "Чтение событий из топика events")
    Component(kafka_device_producer, "Kafka Device Producer", "Spring Kafka", "Отправка уникальных device в топик devices")
    Component(kafka_dlt_producer, "Kafka DLT Producer", "Spring Kafka", "Публикация сообщения в dlt-topic при неудачной обработке")
    Component(device_publication_service, "Device Publication Service", "Обработка device")
    Component(kafka_error_handler, "Kafka Error Handler", "Error Handler", "Обработка сообщения неверной схемы, сдвигает offset")
    Component(device_publication_repo, "Device Publication Repository", "DataStax Java Driver", "Запись информации об опубликованных device в Cassandra")
    Component(configs, "Configs", "Конфигурации")

    Rel(kafka_event_consumer, event_service, "Передает десериализованное сообщение")
    Rel(event_service, event_repo, "Сохраняет событие с retry/backoff")
    Rel(event_service, kafka_dlt_producer, "Передача сообщения на публикацию в dlt-topic после исчерпания попыток")
    Rel(event_service, device_publication_service, "Передает device евента")
    Rel(device_publication_service, device_publication_repo, "Сохраняет информацию об опубликованном device с retry/backoff")
    Rel(device_publication_service, dedup_cache, "Проверка публиковался ли device")
    Rel(device_publication_service, kafka_device_producer, "Если device не публиковался, публикуем")
    Rel(kafka_event_consumer, kafka_error_handler, "Проброс сообщения с невалидной схемой")
}

ContainerDb(cassandra, "Cassandra Cluster", "NoSQL", "Хранение событий")
ContainerQueue(kafka, "Kafka Cluster", "Kafka", "event / dlt-topic / devices топики")
Container(schema_registry, "Schema Registry", "Confluent SR", "Хранение схем")

Rel(event_repo, cassandra, "Сохранение евентов", "CQL")
Rel(device_publication_repo, cassandra, "Сохранение опубликованных device", "CQL")
Rel(kafka_event_consumer, schema_registry, "Запрашивает схему для десериализация")
Rel(kafka_device_producer, schema_registry, "Запрашивает ID схемы для сериализации")
Rel(kafka_event_consumer, kafka, "Вычитывание событий из топика events")
Rel(kafka_device_producer, kafka, "Публикация уникальных device в топик devices")
Rel(kafka_dlt_producer, kafka, "Публикации сообщений в dlt-topic при неудачной обработке")
Rel(kafka_dlt_producer, schema_registry, "Запрашивает схему для десериализация")

@enduml