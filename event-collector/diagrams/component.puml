@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container_Boundary(event_collector_service, "Event Collector Service") {
    Component(event_service, "Event Collector Service", "Обработка событий")
    Component(event_repo, "Event Collector Repository", "DataStax Java Driver", "Запись событий в Cassandra")
    Component(dedup_cache, "Deduplicate Cache", "Проверка был ли уже опубликован device-id")
    Component(kafka_event_consumer, "Kafka Event Consumer", "Spring Kafka", "Чтение событий из топика events")
    Component(kafka_device_id_producer, "Kafka DeviceId Producer", "Spring Kafka", "Отправка уникальных device-id в device-id-topic")
    Component(device_id_piblication_service, "Device Id Publication Service", "Обработка device-id")
    Component(device_id_publication_repo, "Device Id Publication Repository", "DataStax Java Driver", "Запись опубликованных device-id в Cassandra")
    Component(configs, "Configs", "Конфигурации")

    Rel(kafka_event_consumer, event_service, "Передает десериализованное сообщение")
    Rel(event_service, event_repo, "Сохраняет событие")
    Rel(event_service, device_id_piblication_service, "Передает device-id евента")
    Rel(device_id_piblication_service, dedup_cache, "Проверка публиковался ли device-id")
    Rel(device_id_piblication_service, device_id_publication_repo, "Сохраняет опубликованный device-id")
    Rel(device_id_piblication_service, kafka_device_id_producer, "Если device-id не публиковался, публикуем")
}

ContainerDb(cassandra, "Cassandra Cluster", "NoSQL", "Хранение событий")
ContainerQueue(kafka, "Kafka Cluster", "Kafka", "event / dlt / device-id топики")
Container(schema_registry, "Schema Registry", "Confluent SR", "Хранение схем")

Rel(event_repo, cassandra, "Сохранение евентов", "CQL")
Rel(device_id_publication_repo, cassandra, "Сохранение опубликованных device-id", "CQL")
Rel(kafka_event_consumer, schema_registry, "Запрашивает схему для десериализация")
Rel(kafka_device_id_producer, schema_registry, "Запрашивает ID схемы для сериализации")
Rel(kafka_event_consumer, kafka, "Вычитывание событий из топика events")
Rel(kafka_device_id_producer, kafka, "Публикация уникальных device-id в топик device-id-topic")

@enduml