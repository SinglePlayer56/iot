@startuml
actor KafkaBroker
participant "Kafka Device Consumer" as KDC
participant "Device Collector Service" as DCS
participant "Device Collector Repository" as DCR
participant "Metrics Service" as MS
participant "Error Handler" as EH
participant "ShardingSphere JDBC Driver" as SSJ
participant "Shard N" as S

loop N попыток
    DCS -> DCR : Сохранение события
    DCR -> SSJ: Вызов JDBC-запроса(маршрутизация на нужный шард)
    SSJ -> S : Выполнение SQL на выбранном шарде
    alt Успешно
        S --> SSJ : OK
        SSJ --> DCR : OK
        DCR --> DCS : OK
        DCS -> MS : Инкремент успешного сохранения(через аспект)
        DCS --> KDC : OK
        KDC -> KafkaBroker : Отправка ACK
        break
    else Ошибка
        S --> SSJ : Ошибка
        SSJ --> DCR : Ошибка
        DCR --> DCS : Ошибка
    end
end

alt Все попытки неудачны
    DCS -> EH : Ошибка сохранения
    EH -> MS : Инкремент ошибок (через аспект)
    EH -> KafkaBroker : Отправка сообщения в DLT
    KafkaBroker --> EH : Подтверждение (DLT ACK)
    EH --> KDC : OK
    KDC -> KafkaBroker : Отправка ACK
end
@enduml